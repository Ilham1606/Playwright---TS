# Environment Variables Template
# Copy this to .env and fill in your values
# Note: .env is in .gitignore and won't be committed

# Application URLs
BASE_URL=https://example.com
API_URL=https://api.example.com
BASE_URL_CONDUIT = "https://playground.bondaracademy.com"
BASE_URL_DUMMYJSON = "https://dummyjson.com"
BASE_URL_BONDARCONDUIT = "https://conduit.bondaracademy.com"

# Test User Credentials (NEVER commit actual passwords!)
TEST_EMAIL_CONDUIT = "testgen@test.com"
TEST_PASSWORD_CONDUIT = "test12345678"

# Database Connection (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=testuser
# DB_PASSWORD=testpass
# DB_NAME=testdb

# API Keys (for external services)
API_KEY=your_api_key_here
AUTH_TOKEN=your_auth_token_here

# Test Configuration
TEST_TIMEOUT=30000
HEADLESS=false
DEBUG_MODE=false

# CI-specific (automatically set by GitHub Actions)
# CI=true
# GITHUB_ACTIONS=true
